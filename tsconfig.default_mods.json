{
  // The default mods (default_mods/README.md): browser code that imports no
  // app code, not even its types, so it gets no `types` and no `paths`.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.default_mods.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["default_mods"]
}
