{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
  // The default mod fixtures are build input, some broken on purpose (build/default_mod_build.test.ts).
  "exclude": ["src/test/fixtures/default_mods"]
}
