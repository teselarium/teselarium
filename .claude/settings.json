{
  "permissions": {
    "allow": [
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(openspec validate *)"
    ],
    "deny": [
      "Edit(.devcontainer/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh api *)"

    ]
  },
  "autoMemoryEnabled": false,
  "idleCompaction": false
}
