{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-e2e-*/**",
    "src/test/fixtures/default_mods/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "max-depth": ["error", 3],
    "func-style": ["error", "declaration"],
    "func-names": ["error", "always"],
    "typescript/explicit-function-return-type": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": "error"
  },
  "overrides": [
    {
      "files": ["src/vendor/**"],
      "rules": {
        "react/only-export-components": "off",
        "func-style": "off",
        "func-names": "off",
        "typescript/explicit-function-return-type": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/**", "!@/vendor/**"],
                "message": "Vendored code never imports project code (src/vendor/shadcn/README.md)."
              },
              {
                "regex": "^(\\.\\./){3,}",
                "message": "Vendored code never imports project code (src/vendor/shadcn/README.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "./sample_mod.ts",
                "message": "Only the shipped samples' own tests use e2e/sample_mod.ts (docs/code_conventions.md, Tests)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["e2e/sample_*.spec.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["default_mods/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(src|e2e|build)(/|$)",
                "message": "Default mods import no app code: only their own files, npm packages and default_mods/mod_api.d.ts (default_mods/README.md)."
              },
              {
                "regex": "^@/",
                "message": "Default mods import no app code: only their own files, npm packages and default_mods/mod_api.d.ts (default_mods/README.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["default_mods/*/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./){2,}(src|e2e|build)(/|$)",
                "message": "Default mods import no app code: only their own files, npm packages and default_mods/mod_api.d.ts (default_mods/README.md)."
              },
              {
                "regex": "^@/",
                "message": "Default mods import no app code: only their own files, npm packages and default_mods/mod_api.d.ts (default_mods/README.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["default_mods/*/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./){3,}(src|e2e|build)(/|$)",
                "message": "Default mods import no app code: only their own files, npm packages and default_mods/mod_api.d.ts (default_mods/README.md)."
              },
              {
                "regex": "^@/",
                "message": "Default mods import no app code: only their own files, npm packages and default_mods/mod_api.d.ts (default_mods/README.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
